<!DOCTYPE html>
<html lang="tr">
  <head>
    <title>LeaveFlow — Modern Çalışan İzin Yönetim Sistemi</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Top Navigation Bar -->
    <header class="navbar">
      <div style="display: flex; align-items: center; gap: 2rem;">
        <a href="<%= logged_in? ? dashboard_path : login_path %>" class="nav-brand">
          <div class="nav-logo-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
              <path d="m9 16 2 2 4-4"/>
            </svg>
          </div>
          <span>LeaveFlow</span>
        </a>

        <% if logged_in? %>
          <nav class="nav-menu">
            <%= link_to dashboard_path, class: "nav-link #{'active' if current_page?(dashboard_path)}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
              Özet Panel
            <% end %>

            <%= link_to leave_requests_path, class: "nav-link #{'active' if current_page?(leave_requests_path)}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
              İzin Taleplerim
            <% end %>

            <%= link_to manager_calendar_path, class: "nav-link #{'active' if current_page?(manager_calendar_path)}" do %>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              İzin Takvimi
            <% end %>

            <% if current_user.manager? %>
              <%= link_to manager_leave_requests_path, class: "nav-link #{'active' if request.path.start_with?('/manager/leave_requests')}" do %>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
                Yönetici Onay Paneli
                <% pending_count = LeaveRequest.pending_requests.count %>
                <% if pending_count > 0 %>
                  <span class="nav-badge-pill"><%= pending_count %></span>
                <% end %>
              <% end %>
            <% end %>
          </nav>
        <% end %>
      </div>

      <% if logged_in? %>
        <div style="display: flex; align-items: center; gap: 1rem;">
          <div class="user-profile-badge">
            <span style="font-weight: 600;"><%= current_user.name %></span>
            <span class="user-role-tag <%= current_user.role %>"><%= current_user.role == 'manager' ? 'Yönetici' : 'Çalışan' %></span>
            <span style="color: var(--text-muted); font-size: 0.8rem;">(<%= current_user.department %>)</span>
            <span style="background: white; border-radius: 9999px; padding: 0.15rem 0.5rem; font-weight: 700; color: var(--primary); font-size: 0.8rem;">
              <%= current_user.annual_leave_balance %> gün
            </span>
          </div>

          <%= link_to new_leave_request_path, class: "btn btn-primary btn-sm" do %>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Yeni İzin Talebi
          <% end %>

          <%= button_to logout_path, method: :delete, class: "btn btn-secondary btn-sm", style: "border: none; background: transparent; color: var(--text-muted);" do %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Çıkış
          <% end %>
        </div>
      <% else %>
        <div>
          <%= link_to "Giriş Yap", login_path, class: "btn btn-primary btn-sm" %>
        </div>
      <% end %>
    </header>

    <!-- Main Container -->
    <main class="container">
      <% if flash[:notice] || flash[:alert] %>
        <div class="flash-container">
          <% if flash[:notice] %>
            <div class="flash-message flash-notice">
              <span><%= flash[:notice] %></span>
            </div>
          <% end %>
          <% if flash[:alert] %>
            <div class="flash-message flash-alert">
              <span><%= flash[:alert] %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <!-- Footer -->
    <footer>
      <p><strong>LeaveFlow</strong> — Üniversite Bireysel Yazılım Geliştirme Projesi &copy; <%= Date.current.year %></p>
      <p style="font-size: 0.8rem; margin-top: 0.25rem; color: var(--text-light);">
        İlham Kaynağı: Kurumsal İzin Yönetimi (Workday HCM). SLA Süresi: 48 Saat. Hafta sonları izin günlerine katılmaz.
      </p>
    </footer>
  </body>
</html>
