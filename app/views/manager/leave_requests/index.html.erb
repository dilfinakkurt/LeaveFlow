<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.35rem;">
      <span style="background: #e0e7ff; color: #3730a3; font-size: 0.75rem; font-weight: 700; padding: 0.15rem 0.5rem; border-radius: 4px;">
        YÖNETİCİ PORTALI
      </span>
      <span style="color: var(--text-muted); font-size: 0.85rem;">48 Saatlik Onay SLA Sistemi</span>
    </div>
    <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--dark);">
      İzin Talepleri Onay Paneli
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
      Çalışanların izin başvurularını inceleyin, ekip çakışmalarını gözlemleyin ve karara bağlayın.
    </p>
  </div>

  <div>
    <%= link_to manager_calendar_path, class: "btn btn-secondary" do %>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
      Onaylı İzinler Takvimi
    <% end %>
  </div>
</div>

<!-- Manager Metric Counters -->
<div class="grid-4">
  <div class="stat-card" style="border-left: 4px solid #f59e0b;">
    <div>
      <div class="stat-title">Bekleyen Talepler</div>
      <div class="stat-value" style="color: #b45309;"><%= @pending_count %></div>
    </div>
    <div class="stat-icon" style="background-color: #fef3c7; color: #b45309;">⏳</div>
  </div>

  <div class="stat-card" style="border-left: 4px solid #ef4444;">
    <div>
      <div class="stat-title">Gecikmiş Talepler (SLA)</div>
      <div class="stat-value" style="color: #b91c1c;"><%= @overdue_count %></div>
    </div>
    <div class="stat-icon" style="background-color: #fee2e2; color: #b91c1c;">⚠️</div>
  </div>

  <div class="stat-card" style="border-left: 4px solid #10b981;">
    <div>
      <div class="stat-title">Onaylanan İzinler</div>
      <div class="stat-value" style="color: #047857;"><%= @approved_count %></div>
    </div>
    <div class="stat-icon" style="background-color: #d1fae5; color: #047857;">✅</div>
  </div>

  <div class="stat-card" style="border-left: 4px solid #64748b;">
    <div>
      <div class="stat-title">Toplam Kayıt</div>
      <div class="stat-value" style="color: var(--dark);"><%= @all_count %></div>
    </div>
    <div class="stat-icon" style="background-color: #f1f5f9; color: #475569;">📊</div>
  </div>
</div>

<!-- Filter Tabs -->
<div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
  <%= link_to manager_leave_requests_path(filter: "pending"), class: "btn #{ @filter == 'pending' ? 'btn-primary' : 'btn-secondary' } btn-sm" do %>
    Bekleyenler (<%= @pending_count %>)
  <% end %>

  <%= link_to manager_leave_requests_path(filter: "overdue"), class: "btn #{ @filter == 'overdue' ? 'btn-danger' : 'btn-secondary' } btn-sm" do %>
    ⚠️ Gecikmişler - SLA 48h (<%= @overdue_count %>)
  <% end %>

  <%= link_to manager_leave_requests_path(filter: "approved"), class: "btn #{ @filter == 'approved' ? 'btn-primary' : 'btn-secondary' } btn-sm" do %>
    Onaylananlar (<%= @approved_count %>)
  <% end %>

  <%= link_to manager_leave_requests_path(filter: "rejected"), class: "btn #{ @filter == 'rejected' ? 'btn-primary' : 'btn-secondary' } btn-sm" do %>
    Reddedilenler (<%= @rejected_count %>)
  <% end %>

  <%= link_to manager_leave_requests_path(filter: "all"), class: "btn #{ @filter == 'all' ? 'btn-primary' : 'btn-secondary' } btn-sm" do %>
    Tümü (<%= @all_count %>)
  <% end %>
</div>

<!-- Requests Table Card -->
<div class="card" style="padding: 0; overflow: hidden;">
  <% if @leave_requests.any? %>
    <div class="table-container" style="border: none;">
      <table>
        <thead>
          <tr>
            <th>Çalışan</th>
            <th>Departman</th>
            <th>İzin Türü</th>
            <th>Tarihler</th>
            <th>Süre</th>
            <th>Mevcut Bakiye</th>
            <th>Ekip Çakışması</th>
            <th>SLA Durumu</th>
            <th style="min-width: 240px; text-align: right;">Karar / İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <% @leave_requests.each do |req| %>
            <tr style="<%= req.overdue? ? 'background-color: #fef2f2;' : '' %>">
              <td>
                <strong><%= req.user.name %></strong>
                <div style="font-size: 0.75rem; color: var(--text-muted);"><%= req.user.email %></div>
              </td>
              <td>
                <span style="background: #f1f5f9; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">
                  <%= req.user.department %>
                </span>
              </td>
              <td>
                <%= req.leave_type_label %>
              </td>
              <td>
                <div><%= req.start_date.strftime("%d.%m.%Y") %></div>
                <div style="font-size: 0.75rem; color: var(--text-muted);">&ndash; <%= req.end_date.strftime("%d.%m.%Y") %></div>
              </td>
              <td>
                <strong style="color: var(--primary);"><%= req.working_days_count %></strong> gün
              </td>
              <td>
                <span style="font-size: 0.85rem;">
                  <%= req.user.remaining_balance_for(req.leave_type) ? "#{req.user.remaining_balance_for(req.leave_type)} gün" : 'Limitsiz' %>
                </span>
              </td>
              <td>
                <% conflicts = req.conflicting_team_requests %>
                <% if conflicts.any? %>
                  <span class="badge" style="background-color: #fef3c7; color: #92400e; border: 1px solid #fcd34d;" title="Aynı departmandan <%= conflicts.map { |c| c.user.name }.join(', ') %> izinde">
                    ⚠️ <%= conflicts.count %> Çakışma
                  </span>
                <% else %>
                  <span style="color: #10b981; font-size: 0.8rem;">✓ Çakışma yok</span>
                <% end %>
              </td>
              <td>
                <% if req.pending? %>
                  <% if req.overdue? %>
                    <span class="badge badge-overdue" title="48 saatlik SLA doldu!">
                      ⚠️ Gecikmiş (>48s)
                    </span>
                  <% else %>
                    <span style="color: var(--text-muted); font-size: 0.8rem;">
                      <%= time_ago_in_words(req.created_at) %> önce
                    </span>
                  <% end %>
                <% else %>
                  <span class="badge badge-<%= req.status %>">
                    <%= req.status_label %>
                  </span>
                <% end %>
              </td>
              <td style="text-align: right;">
                <% if req.pending? %>
                  <div style="display: flex; gap: 0.4rem; justify-content: flex-end; align-items: center;">
                    <%= button_to approve_manager_leave_request_path(req), method: :patch, class: "btn btn-success btn-sm", data: { turbo_confirm: "#{req.user.name} çalışanının iznini onaylamak istiyor musunuz? (Bakiyeden #{req.working_days_count} gün düşülecektir)" } do %>
                      ✓ Onayla
                    <% end %>

                    <!-- Quick Reject toggle form -->
                    <button type="button" class="btn btn-danger btn-sm" onclick="toggleRejectForm(<%= req.id %>)">
                      ✗ Reddet
                    </button>

                    <%= link_to "Detay", manager_leave_request_path(req), class: "btn btn-secondary btn-sm" %>
                  </div>

                  <!-- Inline Rejection Form (hidden by default) -->
                  <div id="reject_form_<%= req.id %>" style="display: none; margin-top: 0.5rem; text-align: left;">
                    <%= form_with url: reject_manager_leave_request_path(req), method: :patch, local: true do |rf| %>
                      <div style="display: flex; gap: 0.35rem;">
                        <%= rf.text_field :rejection_reason, placeholder: "Ret gerekçesi zorunludur...", class: "form-control", style: "padding: 0.3rem 0.5rem; font-size: 0.8rem;", required: true %>
                        <%= rf.submit "Reddi Onayla", class: "btn btn-danger btn-sm" %>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div style="display: flex; gap: 0.4rem; justify-content: flex-end; align-items: center;">
                    <%= link_to "İncele", manager_leave_request_path(req), class: "btn btn-secondary btn-sm" %>
                  </div>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">🎉</div>
      <div class="empty-state-title">Seçilen Filtrede Talep Bulunmuyor</div>
      <div class="empty-state-text">Şu anda incelenmeyi bekleyen herhangi bir izin talebi yok.</div>
      <%= link_to "Tüm Talepleri Görüntüle", manager_leave_requests_path(filter: "all"), class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>

<script>
  function toggleRejectForm(id) {
    const el = document.getElementById("reject_form_" + id);
    if (el) {
      el.style.display = el.style.display === "none" ? "block" : "none";
    }
  }
</script>
