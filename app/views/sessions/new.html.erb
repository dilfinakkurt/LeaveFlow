<div style="max-width: 440px; margin: 3rem auto;">
  <div class="card" style="padding: 2.5rem 2rem; box-shadow: var(--shadow-lg);">
    <div style="text-align: center; margin-bottom: 2rem;">
      <div style="width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, var(--primary) 0%, #0284c7 100%); display: inline-flex; align-items: center; justify-content: center; color: white; margin-bottom: 1rem; box-shadow: 0 4px 10px rgba(5, 150, 105, 0.3);">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
          <path d="m9 16 2 2 4-4"/>
        </svg>
      </div>
      <h1 style="font-size: 1.5rem; font-weight: 800; color: var(--dark); margin-bottom: 0.35rem;">LeaveFlow Girişi</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Çalışan İzin Talebi ve Yönetici Onay Sistemi</p>
    </div>

    <%= form_with url: login_path, method: :post, local: true do |f| %>
      <div class="form-group">
        <%= f.label :email, "E-posta Adresi", class: "form-label" %>
        <%= f.email_field :email, id: "login_email", class: "form-control", placeholder: "ornek@leaveflow.com", required: true, autofocus: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Parola", class: "form-label" %>
        <%= f.password_field :password, id: "login_password", class: "form-control", placeholder: "••••••••", required: true %>
      </div>

      <div style="margin-top: 1.5rem;">
        <%= f.submit "Giriş Yap", class: "btn btn-primary", style: "width: 100%; padding: 0.75rem;" %>
      </div>
    <% end %>

    <!-- Demo Quick-Fill Buttons -->
    <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px dashed var(--border-color);">
      <p style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); text-align: center; margin-bottom: 0.75rem;">
        Hızlı Değerlendirme & Test Hesapları
      </p>
      
      <div style="display: flex; flex-direction: column; gap: 0.5rem;">
        <button type="button" class="btn btn-secondary btn-sm" onclick="fillDemo('ahmet@leaveflow.com', 'password123')" style="justify-content: flex-start; text-align: left;">
          <span style="background: #e2e8f0; border-radius: 4px; padding: 0.1rem 0.4rem; font-size: 0.75rem; font-weight: 700; margin-right: 0.5rem;">Çalışan</span>
          <span>ahmet@leaveflow.com</span>
        </button>

        <button type="button" class="btn btn-secondary btn-sm" onclick="fillDemo('ayse.yonetici@leaveflow.com', 'password123')" style="justify-content: flex-start; text-align: left;">
          <span style="background: #e0e7ff; color: #3730a3; border-radius: 4px; padding: 0.1rem 0.4rem; font-size: 0.75rem; font-weight: 700; margin-right: 0.5rem;">Yönetici</span>
          <span>ayse.yonetici@leaveflow.com</span>
        </button>

        <button type="button" class="btn btn-secondary btn-sm" onclick="fillDemo('mehmet@leaveflow.com', 'password123')" style="justify-content: flex-start; text-align: left;">
          <span style="background: #e2e8f0; border-radius: 4px; padding: 0.1rem 0.4rem; font-size: 0.75rem; font-weight: 700; margin-right: 0.5rem;">Çalışan 2 (Çakışma Testi)</span>
          <span>mehmet@leaveflow.com</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function fillDemo(email, password) {
    document.getElementById('login_email').value = email;
    document.getElementById('login_password').value = password;
  }
</script>
